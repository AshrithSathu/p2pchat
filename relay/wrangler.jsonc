{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "p2pchat-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TURN_PROVIDER": "cloudflare",
    "COTURN_SHARED_SECRET": "",
    "COTURN_URLS": "",
  },
  "secrets": {
    "required": ["TURN_KEY_ID", "TURN_KEY_API_TOKEN"],
  },
  "routes": [
    {
      "pattern": "p2pchat-relay.sathuashrith.com",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY_ROOMS", "class_name": "RelayRoom" }],
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "p2pchat-releases",
    },
  ],
  "exports": {
    "RelayRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}

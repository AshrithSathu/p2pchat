{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "p2pchat-landing",
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "p2pchat.sathuashrith.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
